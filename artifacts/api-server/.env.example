# Production on DigitalOcean (nginx proxies /api → this port)
API_PORT=5008
PORT=5008

# Required when DB/auth are implemented
DATABASE_URL=postgresql://user:pass@host:25060/recall?sslmode=require
JWT_SECRET=change-me-min-32-chars

# Optional — AI features disabled when unset
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
