# Production on DigitalOcean (nginx proxies /api → this port)
API_PORT=5008
PORT=5008
# Bind localhost only in production (nginx reverse proxy)
HOST=127.0.0.1

# Comma-separated browser origins allowed to call the API (production default in code)
# CORS_ORIGINS=https://recall-app.net,https://www.recall-app.net

# Rate limits (per IP, behind nginx trust proxy)
# AI_RATE_LIMIT_MAX=30
# AI_RATE_LIMIT_WINDOW_MS=900000
# GENERAL_RATE_LIMIT_MAX=200

# Max JSON body size for API requests
# JSON_BODY_LIMIT=256kb

# Required for authentication
DATABASE_URL=postgresql://user:pass@host:25060/recall?sslmode=require

# Postgres pool cap for THIS process. The DO managed cluster is shared with
# other apps on the droplet (max_connections ≈ 25, ~3 reserved for superuser),
# so keep Recall's slice small. Default 4 when unset; hard-capped at 10.
# NOTE: this cap is PER PROCESS. Recall runs two PM2 processes (recall-api +
# recall-worker), so total connections ≈ 2 × PG_POOL_MAX. Prod uses 3 (≈6 total).
# PG_POOL_MAX=3
# Release idle sockets quickly / fail fast when the cluster is saturated.
# PG_IDLE_TIMEOUT_MS=10000
# PG_CONNECT_TIMEOUT_MS=15000
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# JWT_EXPIRES_IN=7d

# Registration lock (production default: false when unset)
ALLOW_PUBLIC_REGISTER=false
# Optional recovery invite when registration is locked
# REGISTER_INVITE_CODE=

# Required in production: AES-256-GCM key for connector OAuth/API secrets at rest
# (64 hex chars recommended). The API refuses to start in production without it.
# SECRETS_ENCRYPTION_KEY=

# Session cookie (httpOnly JWT)
# SESSION_COOKIE_NAME=recall_session
# SESSION_COOKIE_SECURE=true
# LOGIN_RATE_LIMIT_MAX=20

# Optional — AI features disabled when unset
OPENAI_API_KEY=
# Main answer model. gpt-4.1-mini is faster and higher quality than gpt-4o-mini.
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Optional — faster/cheaper model for the small Gmail/Drive query planners.
# Falls back to OPENAI_MODEL when unset.
OPENAI_PLANNER_MODEL=gpt-4.1-nano

# Optional — OpenAI TTS for Ask answers (defaults: tts-1 / nova)
# OPENAI_TTS_MODEL=tts-1
# OPENAI_TTS_VOICE=nova

# Google OAuth connector (Gmail, Calendar, Contacts, Drive — read-only)
# Create a Web OAuth client in Google Cloud; enable Gmail, Calendar, People, Drive APIs.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Production redirect (must match the OAuth client exactly):
# GOOGLE_OAUTH_REDIRECT_URI=https://recall-app.net/api/connectors/google/oauth/callback
# Where to send the browser after connect (defaults to https://recall-app.net):
# APP_PUBLIC_URL=https://recall-app.net

# Microsoft Graph OAuth (Outlook mail + Teams chats — read-only; optional)
# Azure app registration; redirect must match exactly.
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=common
# MICROSOFT_OAUTH_REDIRECT_URI=https://recall-app.net/api/connectors/microsoft/oauth/callback

# Homey Pro (Athom Web API OAuth + Flow webhooks)
# Create a Web API Client at https://api.developer.homey.app/ with device + flow scopes.
# HOMEY_CLIENT_ID=
# HOMEY_CLIENT_SECRET=
# HOMEY_OAUTH_REDIRECT_URI=https://recall-app.net/api/connectors/homey/oauth/callback
# Optional quiet-hours timezone for Homey alert filtering (defaults America/New_York):
# RECALL_TIMEZONE=America/New_York

# Finance spend integrity: exclude transfers / credit-card payments from "spent".
# Default on when unset. Set to false to restore sign-only totals.
# FINANCE_EXCLUDE_TRANSFERS=true
